# 本地预览用的环境变量（不要提交，已在 .gitignore 里排除）
#
# 用法：把下面 DEEPSEEK_API_KEY 换成你自己的 key，然后运行 scripts\start-local.bat
#       （这个文件只影响本机预览，与线上 .env.secret 完全无关）
#
# 说明：DeepSeek的 key 与 api.deepseek.com 的 key 不通用，base_url 与 model 必须成对。

# ---- LLM ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-chat

# ---- 联网搜索（可选；留空则联网开关点了也没结果，不影响其它功能）----
TAVILY_API_KEY=
QIANFAN_API_KEY=
QIANFAN_MODEL=

# ---- Azure 语音（可选；TTS 朗读与语音转写都靠它，留空则朗读按钮报「未配置」）----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# ---- 新功能开关（本地预览默认全开，方便一次看全）----
ZQY_MEMORY_V2=1
ZQY_MEMORY_RETRIEVE=b
ZQY_RECALL_ON=1
# ZQY_TTS_OFF=0

# ---- 端口（可选，默认 8092；被占用时改这里）----
# ZQY_LISTEN_PORT=8092
