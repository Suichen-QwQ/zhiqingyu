# 栀情屿 后端环境变量示例（复制为 /home/admin/zhiqingyu/.env.secret，权限 600）
# 说明：
#   1) 真实的 .env.secret 未打进本包（含 API Key），请自行向服务提供商申请。
#   2) 若存在 ~/zhiqingyu/settings.json（站点「模型设置」界面保存），它会**覆盖**本文件里的
#      DEEPSEEK_* 配置；两者冲突时以 settings.json 为准。

# ---- LLM（DeepSeek https://api.deepseek.com）----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 注意：model 与 reasoner_model 必须成对切换（网关 vs api.deepseek.com 的模型名不同）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-chat

# ---- 联网搜索（可选，按优先级）----
TAVILY_API_KEY=
QIANFAN_API_KEY=
QIANFAN_MODEL=

# ---- Azure 语音识别（网页/WebView 录音 → 后端转写）----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# ---- 记忆 v2（W1）----
# 0 = 完全走旧行为（可随时回滚）；1 = 结构化记忆 + 打分选片 + 分类/重要度
ZQY_MEMORY_V2=0
# 注入记忆的字符预算，允许 400~12000
ZQY_MEMORY_BUDGET=4000
# 0 = 纯打分；b = 打分 + BM25 混合；e = 预留向量层（当前离线＝b）
ZQY_MEMORY_RETRIEVE=0
# 记忆引用：默认 1；设为 0 关闭。仅新客户端主动声明支持且启用 v2 时显示。
# 编号对应本轮注入的记忆记录，不保证模型表述正确，也不是原始聊天证据。
# ZQY_MEMORY_CITE=1

# ---- TTS 语音朗读（复用上面的 AZURE_SPEECH_KEY，不需要新账号）----
# 想用别的 key 时设 AZURE_TTS_KEY 覆盖
# ZQY_TTS_VOICE=zh-CN-XiaoxiaoNeural
# ZQY_TTS_RATE=+0%
# ZQY_TTS_CACHE_DIR=/home/admin/zhiqingyu/tts-cache
# ZQY_TTS_CACHE_MAX=300
# ZQY_TTS_MAX_CHARS=1200
# ZQY_TTS_CHUNK_CHARS=400
# 1 = 全局关闭朗读（接口回 503，连缓存也不再服务；聊天不受影响）
# ZQY_TTS_OFF=0

# ---- 共同回忆（W2：日记 → 周/月/季/年 分层摘要 + 级联折叠）----
# 0 = 关闭该功能（接口回 503 recall_off，前端入口自动禁用）
ZQY_RECALL_ON=1
# 默认回溯月数，允许 1~60
# ZQY_RECALL_MONTHS=12
# 一次「整理」最多调用几次模型（每次调用生成一个周期），允许 1~20；限流友好
# ZQY_RECALL_MAX_CALLS=6
# 共同回忆整段文本的字符上限，允许 2000~60000；超出时省略更早的段落
# ZQY_RECALL_TEXT_MAX=12000
# 落盘目录（默认 ~/zhiqingyu/recall）
# ZQY_RECALL_DIR=/home/admin/zhiqingyu/recall

# ---- 安全层：高危情绪识别与温和引导（P0）----
# 0 = 关闭。默认 1：识别到可能指向自伤/自杀的表述时，
#   ① 给模型追加一段「怎么做这一轮回复」的指令（只说给模型的，不进 system，不破坏前缀缓存）；
#   ② 在回复里额外附上求助资源（12356 / 120 / 110）与免责说明。
# 行为约定：【只升级不降级】规则只能把风险往上抬，不能压低模型的判断；
#         【软引导不拦截】永不改写或截断回复，只额外附资源；
#         【fail-open】检测抛异常时一律降级为 low，绝不让安全检测拖垮回复。
# ZQY_SAFETY=1

# ---- 表情发送频率与表情池（2026-10-30）----
# 背景：旧实现把「这条回复要配 1 个表情（绝大多数回复都要配）」写死在提示词里，
# 等于替模型决定几乎每条都配图；而且模型主动把表情名留空（表示这轮不配）时，
# 后端还会按情绪标签硬补一张，两边叠加的结果是「表情几乎从不缺席」。
# 现在改成语义对齐 BaiShou-Next 的频率偏好，默认均衡。
#
# 四档（写进提示词的是一句直接给模型的指令，不是数字）：
#   low    = 很少配，大多数回复不要配表情
#   normal = 均衡（默认），自然贴合气氛时才配，不是每条都需要
#   high   = 较多，大约三条里两条
#   always = 每条都配
# 行为差异（真模型实测 12 条消息）：low 6/12、normal 9/12、high 12/12、always 12/12。
#
# 另一个独立开关：只有 always 档才会在「模型完全没写表情标记」时兜底补一张，
# 其余档位一律尊重模型「这轮不配」的决定。想要以前那种「几乎必配」的效果就设 always。
#
# 表情池注入范围：
#   all  = 全部 352 个名字都列给模型（默认，所有官方表情都可能被选中）
#   core = 只列精选的 102 个常用名字（提示词从 1815 字压到 730 字，
#          代价是其余名字模型看不见、基本不会被选）
# 精选子集按情绪分成七桶（平静/日常/愉悦/焦虑/疲惫/低落/其他高频）先列出来，
# 让模型按当前情绪定位候选，而不是在 352 个平铺名字里瞎挑。
# 「平静」桶是 2026-10-31 补的：它是情绪白名单里排第一、实测最高频的情绪
# （本地 19 条 AI 消息里 10 条 = 53%），但原先七个桶里没有它，最常见的情绪反而
# 零候选，模型只能去平铺的 262 个名字里抓，于是反复落到同一两张（第二章-倾听/摸摸头）。
# 另有反重复提示：后端会把最近几轮配过的表情名拼进【末条 user 消息】
# （不是 system，避免破坏网关前缀缓存），让模型能主动换一张。
#
# 硬保险（dedupe_emote，无需配置、始终生效）：这一轮的表情若和最近 3 条 AI 消息
# 发过的图撞了，后端会在【同一情绪桶内】自动换成最久没用过的那张，形成轮换。
# 这是确定性的，不依赖模型配合 —— 真模型 A/B 实测发现，光靠提示词时模型会
# 用「干脆不配表情」来满足「别重复」（压力场景 8 次里 2 次直接空着）。
# 情绪不在七桶里、或桶内实在没别的图时，宁可保留原图，也不跨情绪乱贴或留空。
#
# ZQY_EMOTE_FREQ=normal
# ZQY_EMOTE_POOL=all

# ---- 后台小任务（P1：抽事实 / 管记忆 / 起标题）----
# 这类调用只是「顺手变得更好」，失败完全不影响这轮对话，所以刻意走最弱推理档：
#   * 强制 think=False —— 绝不落到 reasoner 模型（又贵又慢，而产出只是一个标题、一句事实）
#   * max_tokens 硬上限 1200
#   * 独立短超时（默认 20s），而不是主链路的 60s
# 为什么重要：manage_memory 在回复返回【之前】同步执行。以前它跟主链路共用 60s 超时，
# 网关一限流，用户就要等满 60s 才拿到本来就该秒回的回复。
# 范围：5~60 秒。日记与共同回忆是用户点按钮触发的长篇生成，不受此限制。
# ZQY_SMALL_TIMEOUT=20

# ---- 首字超时看门狗（流式）----
# 从发出请求到收到第一个字节的容忍上限，默认 45 秒，范围 10~120。
# 为什么需要它：网关限流时的典型症状是「HTTP 200 连上、然后挂着不动」，
# 以前只能干等满该模型的 socket 超时（默认 60s），用户只看到「正在思考」，
# 而且【不会顺延备用模型】——因为它既没报错也没吐字，整轮就这么白等。
# 现在：收到响应头后先把 socket 收紧到这个值，读到第一个字节立刻调回原超时，
# 所以「迟迟不开口」会快速失败并自动顺延下一个模型，而长回复不受任何影响。
# 全链都这样时会返回 error_code=first_output_timeout，提示「过一会儿再点一次」，
# 与「模型服务没接上」区分开。
# ZQY_FIRST_OUTPUT_TIMEOUT=45

# ---- 上下文透明面板 + 状态区块（W2：只读，无开关，不调模型）----
# 每轮回复带一份 context（记忆选片明细/摘要/联网/历史/人设/模型/开关），前端 ⓘ 展示；
# GET /api/status 给设置页「状态」tab 用。两者都不需要配置项，也都可以随时停用（前端自动降级）。

# ---- P2：提问卡片 / 回溯插话 / 归档（2026-10-29）----
# 提问卡片：模型在流式回复中需要用户「二选一」时，先发一张卡片（event: ask），
# 阻塞等 POST /api/answer，拿到回答再继续写。超时/取消都算正常结局，不会让整轮失败。
# 只有流式路径挂这个工具：非流式没有 SSE 出口，弹了卡用户也看不到。
# ZQY_ASK_TIMEOUT=120
#
# 回溯插话（回合中插话）：用户在一轮回复还没写完时又补一句，POST /api/inbox 入队，
# 该轮收尾时接着写一段（event: turn），不会另起一条流、也不会抢气泡。
# 一轮最多续写一次，且必须有正文才续写；不做落库，会话结束即清。
#
# 归档：GET /api/archive 下载整包 zip（storage + 长期记忆 + 共同回忆 + manifest），
# POST /api/archive?action=import 导入。刻意不含 settings.json（里面有 api_key）。
# 导入默认只补空缺，要覆盖已有数据必须显式加 force=1；上传上限 32MB。

# ---- 运行时路径（systemd unit 里已设置，直跑时需要）----
# ZQY_LISTEN_HOST=127.0.0.1
# ZQY_LISTEN_PORT=8092
# ZQY_STATIC_DIR=/usr/share/nginx/html/zhiqingyu
# ZQY_STORAGE_FILE=/home/admin/zhiqingyu/storage/zqy-data.json
# ZQY_MEMORY_DIR=/home/admin/zhiqingyu/memories
# ZQY_SETTINGS_FILE=/home/admin/zhiqingyu/settings.json
